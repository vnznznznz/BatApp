# Copy this file to .env and fill in the values from your Supabase project,
# under Project Settings → API. Restart the dev server afterwards — Expo inlines
# EXPO_PUBLIC_* variables at build time, so a running server will not pick them up.
#
# The two Supabase values below are placeholders. The app refuses to start with
# them, and a production bundle is not built with them or without them
# (metro.config.js) - so that a forgotten .env shows at once, and not as
# "No connection" on somebody's phone. To see whether your values are complete:
#   node scripts/check-build-env.js --for-others
#
# .env is gitignored and must stay that way. That is also why an EAS build never
# sees it: there, all four values are set in the EAS environment instead.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. It is designed to be public and ships inside the
# app bundle; row level security is what protects the data behind it.
#
# NEVER put the service_role or sb_secret_ key here. It bypasses row level
# security entirely, and anything in EXPO_PUBLIC_* is readable by anyone who
# downloads the app. The app refuses to start if it detects one — see
# src/lib/env.ts — but the real safeguard is not pasting it in the first place.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the app's "Contact" and "Privacy policy" buttons lead: an https URL,
# or mailto:someone@example.com for the contact. Unset, the buttons are not
# shown - fine for development, but a build for anyone else needs both
# (Apple Guidelines 1.2 and 5.1.1). Never a personal postal address: anything
# here ends up in the app bundle. See docs/GO-LIVE.md.
#
# Night Courier's own builds use its help page and privacy policy on GitHub Pages:
#   EXPO_PUBLIC_CONTACT_URL=https://vnznznznz.github.io/night-courier/
#   EXPO_PUBLIC_PRIVACY_POLICY_URL=https://vnznznznz.github.io/night-courier/privacy-policy.de.html
EXPO_PUBLIC_CONTACT_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
