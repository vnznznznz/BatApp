# Copy this file to .env and fill in the values from your Supabase project,
# under Project Settings → API. Restart the dev server afterwards — Expo inlines
# EXPO_PUBLIC_* variables at build time, so a running server will not pick them up.
#
# .env is gitignored and must stay that way.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. It is designed to be public and ships inside the
# app bundle; row level security is what protects the data behind it.
#
# NEVER put the service_role or sb_secret_ key here. It bypasses row level
# security entirely, and anything in EXPO_PUBLIC_* is readable by anyone who
# downloads the app. The app refuses to start if it detects one — see
# src/lib/env.ts — but the real safeguard is not pasting it in the first place.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
